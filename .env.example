# Everything the site reads at build or request time. Copy to .env.local.
# There is no database: venues, coaches, plans and products are a checked-in
# file (content/academy.json) and the timetable comes from bluetick.

# Where bluetick is deployed. The schedule page GETs
# {BLUETICK_URL}/api/diary/{BLUETICK_DIARY_KEY}. Server-only.
BLUETICK_URL=https://bluetick.example.com

# The academy's bluetick workspace key — three hyphenated words. Server-only
# copy, used to build the diary URL.
BLUETICK_DIARY_KEY=ping-pong-club

# The same key, public, so a wa.me link can prefill it: one WhatsApp number
# serves every bluetick workspace, so the message has to say which business
# the sender means. Every link closes with "With my code: <key>"; bluetick
# reads the key from anywhere in the text.
NEXT_PUBLIC_BLUETICK_KEY=ping-pong-club

# The WhatsApp number the academy now answers on — digits only, no "+", because
# that is what wa.me takes. Bluetick's number.
NEXT_PUBLIC_WHATSAPP_NUMBER=12402623933

# Canonical site origin. Used for metadataBase, robots.txt and sitemap.xml, and
# to rebuild the URL Twilio signed for the webhook below.
NEXT_PUBLIC_APP_URL=https://sharwinacademy.com

# Mapbox public token for the venue map. Without it the map degrades to a plain
# list of venues, which is a deliberate fallback, not a failure.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-token

# Twilio auth token for the OLD WhatsApp number. /api/whatsapp validates
# X-Twilio-Signature with it and replies with a "we've moved" message; without
# it every inbound webhook is rejected with 403.
TWILIO_AUTH_TOKEN=

# Optional: the exact public URL Twilio was configured with, if it differs from
# ${NEXT_PUBLIC_APP_URL}/api/whatsapp (a proxy, a preview deployment).
# WHATSAPP_WEBHOOK_URL=

# Only scripts/export-content.mjs reads these, only from .env.local, and only to
# SELECT. They are not needed to build or run the site.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# The founder's key to /schedule. The page lists the whole week, private
# lessons at people's homes included, and opens only from a link carrying this:
# {NEXT_PUBLIC_APP_URL}/schedule?key=<SCHEDULE_ADMIN_KEY>. Server-only. With it
# unset nobody gets in, the founder included. Bluetick's assistant holds that
# link in its standing memory `schedule-page` — rotate the two together.
SCHEDULE_ADMIN_KEY=
